{
  "manifest_version": 3,
  "name": "YouTube 时间点笔记",
  "description": "标记视频时间点、做笔记，支持文件夹分类管理所有视频记录",
  "version": "2.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-timestamp": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "标记当前视频时间点"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube 时间点笔记"
  }
}
